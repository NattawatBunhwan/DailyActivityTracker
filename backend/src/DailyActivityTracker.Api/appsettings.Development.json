{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "AuthCookie": {
    "CookieName": "refreshToken",
    "Path": "/api/Auth",
    "SameSite": "None",
    "Secure": "Always",
    "HttpOnly": true,
    "ExpirationDays": 7
  }
}
