{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "https://api.yourdomain.com",
    "Audience": "https://app.yourdomain.com",
    "ExpirationMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.yourdomain.com"
    ]
  }
}
