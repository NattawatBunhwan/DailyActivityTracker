{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "https://api.example.com",
    "Audience": "urn:dailyactivitytracker:api",
    "ExpirationMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.example.com"
    ]
  },
  "AuthCookie": {
    "CookieName": "refreshToken",
    "Path": "/api/Auth",
    "Domain": null,
    "SameSite": "Lax",
    "Secure": "Always",
    "HttpOnly": true,
    "ExpirationDays": 7
  }
}
